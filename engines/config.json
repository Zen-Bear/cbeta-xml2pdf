{
  "engines": {
    "defaultChain": [
      "msword",
      "wps",
      "docbuilder",
      "libreoffice",
      "minipdf"
    ],
    "external": {
      "minipdf": {
        "executable": "engines/minipdf.exe",
        "arguments": "convert \"{input}\" -o \"{output}\"",
        "timeoutSeconds": 120,
        "needsFullPreprocessing": true
      }
    },
    "paths": {
      "docbuilder": "C:\\Dev\\DocBuilder8.2\\docbuilder.exe",
      "libreoffice": "C:\\Apps\\LibreOffice\\program\\soffice.com"
    }
  },
  "monochrome": false,
  "docx": {
    "_comment_mappings": "字体映射：仅对系统缺失的字体生效（存在即保留原文）",
    "fontMappings": {
      "標楷體": "KaiTi",
      "DFKai-SB": "KaiTi",
      "BiauKai": "KaiTi",
      "微軟正黑體": "simsun",
      "Microsoft JhengHei": "simsun",
      "新細明體": "SimSun",
      "PMingLiU": "SimSun",
      "細明體": "SimSun",
      "MingLiU": "SimSun",
      "CBETA Supplement": "SimSunExtG"
    },
    "_comment_ratios": "行高系数（行距/字号），按 WPS 实测校准；把 auto 行距改写为 exact",
    "lineHeightRatios": {
      "新細明體": 1.3083,
      "PMingLiU": 1.3083,
      "細明體": 1.3083,
      "MingLiU": 1.3083,
      "KaiTi": 1.24,
      "楷体": 1.24,
      "宋体": 1.2213,
      "SimSun": 1.2213
    },
    "defaultFont": "simsun",
    "footnoteSeparator": {
      "thicknessPt": 0.5,
      "lengthPercent": 30,
      "spaceTwips": 20
    }
  },
  "html": {
    "pageSize": "A4",
    "landscape": false,
    "zoom": 1.0,
    "marginTopPt": 36,
    "marginRightPt": 36,
    "marginBottomPt": 36,
    "marginLeftPt": 36,
    "noteAnchor": {
      "underline": false,
      "fontSizePercent": 65,
      "superscript": true
    },
    "linkStyle": {
      "underline": false,
      "fontSizePercent": 100,
      "superscript": false
    }
  }
}