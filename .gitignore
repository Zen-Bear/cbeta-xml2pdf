# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/

# PyInstaller 打包产物（GUI Release 附件，不入库）
dist/
build/
*.spec

# 产物（可再生）
out/
test/out*/
test/X1077/
[Ee]gg-info/
# 校验产物（自定义 verify_root 落仓库根时；默认 {输出}/验证 已被 out/ 覆盖）
/verify/
/验证/

# 外部 PDF 引擎可执行文件（体积大，改由 GitHub Releases 分发；
# 自行放入 engines/ 目录即可，不入库）
engines/*.exe

# 预设库 presets/（样式 *.css + 配置 *.json + 样张，随仓库发布给用户）
# config.user.json 自 v0.5 起入库为标准预设（机器路径已清洗）；
# 仅轮转旧槽不入库：
presets/config.last.json
# 旧根槽（已迁入 presets/，保留忽略以防残留；前导 / 锚定仓库根，勿匹配 presets/ 下同名入库文件）
/config.user.json
/config.last.json
# run.json（一次运行的组合单，常改，不入库；模板见 docs/主题与样式.md）
run.json

# 测试数据根：本机 CBETA 电子书库路径存这里（不入库，避免机器路径进仓库）
pycbeta/tests/.data_root

# 系统
.DS_Store
Thumbs.db
