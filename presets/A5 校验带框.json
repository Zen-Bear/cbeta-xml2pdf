  "engines": {
    "html2pdf": {
      "chain": [
        "chromium",
        "cbetapdf"
      ]
    },
    "docx2pdf": {
      "chain": [
        "msword",
        "wps",
        "docbuilder",
        "libreoffice",
        "minipdf"
      ]
    },
    "external": {
      "minipdf": {
        "executable": "engines/minipdf.exe",
        "arguments": "convert \"{input}\" -o \"{output}\"",
        "timeoutSeconds": 120
      },
      "cbetapdf": {
        "executable": "engines/cbetapdf.exe",
        "arguments": "\"{input}\" -o \"{output}\"",
        "timeoutSeconds": 300
      }
    },
    "paths": {
      "docbuilder": "C:\\Dev\\DocBuilder8.2\\docbuilder.exe",
      "libreoffice": "C:\\Apps\\LibreOffice\\program\\soffice.com"
    }
  },
  "output": {
    "t2s": false,
    "ignore_xml_style": false,
    "ignore_xml_space": false,
    "verse_caesura": "　　",
    "verse_strip_quotes": false,
    "grayscale": false,
    "page_border": false,
    "bookmarks": true,
    "split_juan": false,
    "show_close_juan": false,
    "suppress_jhead_dup": true,
    "inline_brackets": "fullwidth",
    "footnote_per_page": true,
    "show_notes": true,
    "notes_marker_font": "Times New Roman",
    "suppress_title_notes": false,
    "strip_head_no": false,
    "pdf_zoom": 1.0,
    "font_scale": 1.0,
    "docx": {
      "footnoteSeparator": {
        "thicknessPt": 0.5,
        "lengthPercent": 30,
        "spaceTwips": 20
      },
      "gaijiFonts": {
        "zh-Hant": [
          "CBETA Supplement"
        ],
        "zh-Hans": [
          "SimSun-ExtB",
          "SimSun-ExtG",
          "CBETA Supplement"
        ]
      },
      "fallbackFonts": {
        "zh-Hant": [
          "PMingLiU",
          "SimSun",
          "SimSun-ExtB",
          "SimSun-ExtG",
          "CBETA Supplement",
          "Microsoft YaHei"
        ],
        "zh-Hans": [
          "SimSun",
          "SimSun-ExtB",
          "SimSun-ExtG",
          "CBETA Supplement",
          "Microsoft YaHei"
        ]
      },
      "siddhamFonts": [
        "Ranjana",
        "Siddam"
      ]
    },
    "pagination": {
      "enabled": true,
      "duplex": false,
      "juan": true,
      "juan_first": false,
      "mulu_level1": true,
      "pb": false,
      "tei": true
    },
    "series_title": {
      "enabled": true
    },
    "vertical": false,
    "notes": "footnote",
    "show_body_siddham": true,
    "note_inline_brackets": "fullwidth",
    "corr_cbeta": false,
    "siddham_text": false
  },
  "source": {
    "xml_dir": "",
    "cbeta_ebook": "",
    "title_t2s": true
  },
  "downloads": {
    "xml": "https://raw.githubusercontent.com/cbeta-org/xml-p5/master/{canon}/{canon}{vol}/{file}",
    "html": "https://cbdata.dila.edu.tw/stable/download/html/{id}.html.zip",
    "docx": "https://cbdata.dila.edu.tw/stable/download/docx/{canon}/{id}.zip",
    "epub": "https://cbdata.dila.edu.tw/stable/download/epub/{canon}/{id}.epub",
    "txt": "https://cbdata.dila.edu.tw/stable/download/text/{id}.txt.zip",
    "txt_notes": "https://cbdata.dila.edu.tw/stable/download/text-with-notes/{id}.txt.zip",
    "odt": "https://cbdata.dila.edu.tw/stable/download/odt/{canon}/{id}.zip",
    "figures": "https://raw.githubusercontent.com/cbeta-git/CBR2X-figures/master/{canon}/{file}"
  },
  "verify": {
    "inline_brackets": "halfwidth",
    "suppress_jhead_dup": false,
    "show_close_juan": true,
    "compareInfos": false,
    "maxDiff": 10,
    "diffLines": 5,
    "auto_fetch": true,
    "scope_juan": true,
    "enabled": true
  },
  "annotations": {
    "enabled": false,
    "full_text": false,
    "scheme": "pinyin",
    "style": "field",
    "brackets": [
      "〔",
      "〕"
    ],
    "repeat": "page",
    "file": "e:\\dev\\cbeta\\xml2pdf\\pycbeta\\data\\annotations.txt"
  },
  "formats": [
    "pdf",
    "docx"
  ],
  "engine": "docx2pdf",
  "font_lang": "zh-Hant",
  "pdf-docx-user-theme": "my.css"
}
