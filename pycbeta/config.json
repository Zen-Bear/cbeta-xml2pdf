{
  // ============================================================
  // pycbeta 全局配置（复制本文件修改后，用 --presets-file 指定）
  // 支持 // 行注释；生效格式标注在每条注释尾部
  // ============================================================

  "default_page": "a4",  // 默认纸张（--page 未指定时用它；键大小写不敏感；非法回 a4）

  "pages": {
    // 页面方案：--page 选名字（只管几何：尺寸/边距；字体走 CSS :root 双栏变量）
    // size=[宽mm,高mm]；margins=上下左右 mm；文档兜底字号跟主题 base（body 单源）
    // body_font_size/body_line_height（可选）：该纸张绑定的正文字号/行距，
    //   覆盖 theme body（纸张赢 CSS；不写则跟 CSS）。窄栏 12/1.4，宽栏 10.5/1.5。
    "a4": {
      "size": [210, 297],
      "margins": { "top": 25.4, "right": 25.4, "bottom": 25.4, "left": 25.4 },
      "body_font_size": "12pt",
      "body_line_height": 1.5
    },
    "a5": {
      "size": [148, 210],
      "margins": { "top": 25.4, "right": 25.4, "bottom": 25.4, "left": 25.4 },
      "body_font_size": "12pt",
      "body_line_height": 1.4
    },
    "信纸": {  // letter 美式信纸（216×279mm）
      "size": [216, 279],
      "margins": { "top": 25.4, "right": 25.4, "bottom": 25.4, "left": 25.4 },
      "body_font_size": "12pt",
      "body_line_height": 1.5
    },
    "手机": {  // 约 8 寸 16:9（100×178mm）
      "size": [100, 178],
      "margins": { "top": 10, "right": 10, "bottom": 10, "left": 10 }
    },
    "平板8寸": {  // 8寸（172×108mm，竖版宽×高下同）
      "size": [108, 172],
      "margins": { "top": 10, "right": 10, "bottom": 10, "left": 10 }
    },
    "平板9寸": {  // 9寸（194×121mm）
      "size": [121, 194],
      "margins": { "top": 10, "right": 10, "bottom": 10, "left": 10 }
    },
    "平板11寸": {  // 11寸（237×148mm）
      "size": [148, 237],
      "margins": { "top": 10, "right": 10, "bottom": 10, "left": 10 }
    },
    "32开": {  // 32开（130×184mm）
      "size": [130, 184],
      "margins": { "top": 20, "right": 20, "bottom": 20, "left": 20 },
      "body_font_size": "12pt",
      "body_line_height": 1.4
    },
    "16开": {  // 16开（185×260mm）
      "size": [185, 260],
      "margins": { "top": 20, "right": 20, "bottom": 20, "left": 20 },
      "body_font_size": "10.5pt",
      "body_line_height": 1.5
    },
    "B5": {  // B5（182×257mm，宽栏同 16开）
      "size": [182, 257],
      "margins": { "top": 20, "right": 20, "bottom": 20, "left": 20 },
      "body_font_size": "10.5pt",
      "body_line_height": 1.5
    }
  },

  "engines": {
    // 转换引擎配置（命令行 --engine / --pdf-engine 优先于此处）
    // html2pdf：HTML -> PDF 管线
    // chain = 引擎链（按序尝试，第一个成功者出 PDF）；--engine 强制指定单个时覆盖
    "html2pdf": {
      "chain": ["chromium", "cbetapdf"]
      // chromium | prince | weasyprint | docx2pdf | 及 external 注册的外部引擎
    },
    // docx2pdf：DOCX -> PDF 后端链（按序尝试）
    "docx2pdf": {
      "chain": ["msword", "wps", "docbuilder", "libreoffice", "minipdf"]
      // msword = MS Word(COM)、wps = WPS(COM)、libreoffice = soffice 命令行；
      // docbuilder / minipdf 为外部引擎（见 external/paths，未安装自动跳过）
    },
    // 外部引擎注册表与路径（两条管线共用）
    "external": {
      "minipdf": {
        "executable": "engines/minipdf.exe",
        "arguments": "convert \"{input}\" -o \"{output}\"",
        "timeoutSeconds": 120
      },
      "cbetapdf": {
        "executable": "engines/cbetapdf.exe",
        "arguments": "\"{input}\" -o \"{output}\"",
        "timeoutSeconds": 300
      }
    },
    "paths": {
      "docbuilder": "C:\\Dev\\DocBuilder8.2\\docbuilder.exe",
      "libreoffice": "C:\\Apps\\LibreOffice\\program\\soffice.com"
    }
  },

  "output": {
    // 输出处理规则
    "t2s": false,               // [所有格式] true=OpenCC t2s 简体输出（正文/注释/元数据；未指定 --font-lang 时自动用简体字库；校验时官方基线同步转简体后比对）
    "ignore_xml_style": false,   // [docx|pdf|html|epub] true=忽略 XML 里 <p style="margin-left:…"> 脏数据，缩进统一走 CSS
    "ignore_xml_space": false,   // [docx|pdf|html|epub] true=忽略文本首尾多余空格（含全角 \u3000，如目录行首的空格）
    "verse_caesura": "　　",     // [docx] 偈颂 <caesura/> 分隔符（默认两个全角空格，可改）
    "verse_strip_quotes": false, // [docx] true=去掉偈颂首尾的「『 』」引号，并忽略 lg 的 text-indent 悬挂
    "grayscale": false,          // [docx|pdf] true=全局黑白输出，忽略所有颜色（程序与 CSS 定义的颜色一律不输出）
    "page_border": false,        // [docx|pdf] true=每页四周加框（页面边框）
    "bookmarks": true,           // [docx|pdf] true=按卷加目录书签（PDF 侧栏大纲；DOCX 书签+导航窗格大纲，默认用卷号/卷标题）
    "split_juan": false,         // [docx|pdf] true=按卷输出多个文档（每卷一个文件，文件名带「_卷N」）；默认不分卷
    "show_close_juan": false,    // [docx] true=显示结束卷标题（<cb:juan fun="close">，默认隐藏且不加书签）
    "suppress_jhead_dup": true,  // [docx] true=仅 jhead 去重（卷头 <title> 与书名重复时去重，head 保留书名，默认 true）
    "inline_brackets": "fullwidth", // [六格式] 正文夹注（<note place="inline">，原文）括号形态：halfwidth="()" 对齐CBETA官方，fullwidth="（）"（默认全角）
    "note_inline_brackets": "fullwidth", // [六格式] 校注内联（注释方式=inline 时的脚注/校勘）括号形态：fullwidth（）/halfwidth()/corner〔〕/square[]；与正文夹注、注音括号均独立（常用〔〕[] 与正文夹注（）区分）
    "footnote_per_page": true,   // [docx] true=脚注每页重新编号（默认）；false=全文连续编号
    "show_notes": true,          // [docx|pdf|html|epub|md] true=显示注释（默认）；false=全部关闭注释
    "notes": "footnote",         // [所有格式] 注释方式：footnote=页底脚注（docx/pdf 有效，其余同 endnote）/endnote=文末尾注/inline=括号内联（如（注））；html/epub/md/txt 仅区分 inline 与否
    "show_body_siddham": true, // [docx] true=正文显示悉昙字和读音（如 歾(raṃ)，默认）；false=正文不显示悉昙字和读音，脚注不受影响
    "notes_marker_font": "Times New Roman", // [docx] 注释注码字体（正文 [N]/文末 [N]/脚注编号上标；如 "宋体, SimSun"；字号恒为正文字号×0.75，不随标题段放大，随 font_scale 等比放大）
    "suppress_title_notes": false, // [docx] true=压制卷名/品名校勘注码（标题干净，默认 false 保留）
    "strip_head_no": false,     // [六格式] true=去 head/jhead 行首 No. 令牌（如 X 藏 "No. 1116-B 序"→"序"，余部 lstrip 吃版式空格；正文内 No. 不动；默认 false 保留）
    "corr_cbeta": false,        // [docx|html|epub|pdf] true=CBETA 校改字标红（app.lem 原始 wit 含 #wit.cbeta 的正文用字；docx 红 #FF0000、html/epub span.corr；md/txt 不标）；默认 false 关闭
    "pre_dedent": false,        // [docx|html|epub|pdf] true=预排段（<p cb:type="pre">，如目录）每行行首最多去 N 个空白（半角/全角/制表各计 1；不足去尽；行中不动）；默认 false
    "pre_dedent_spaces": 4,     // [docx|html|epub|pdf] 预排去缩进的 N（默认 4；仅在 pre_dedent=true 时生效）
    "title_smart_wrap": true,   // [docx] true=超 1 行的书名（<title level="m">）在空格/成对转折号 --/—— 处换行（空格去掉、转折号保留在行尾；单个 -–— 是范围号永不断；只估当前版心宽度）；默认 true
    "convert_report": true,     // [所有格式] true=生成转换报告（记录字体替换/缺字/去缩进/折行/去标题No/脏数据忽略/注音待审等），落 {输出}/验证/{id 书名}（验证）/{stem}_转换报告.txt；默认 true；--no-convert-report 关
    "show_dharani_transliteration": false, // [txt|md] true=逐字咒文表（<cb:tt> 无 place="inline"）也显示梵文罗马字母；默认 false 去掉（官方 text-with-notes 一致）
    "pdf_zoom": 1.0,               // [pdf/仅chromium] HTML→PDF 整页缩放（Playwright page.pdf scale，不重排；范围 0.1-2.0，1.0=原尺寸；与 font_scale 正交可叠加）
    "font_scale": 1.0,             // [所有格式] 字号等比缩放（重排式大字，老人版推荐 1.33/1.5；与 pdf_zoom 正交；字号不影响逐字校验）
    "docx": {                      // [docx] DOCX 特有配置
      "footnoteSeparator": {       //   脚注分隔线
        "thicknessPt": 0.5,        //     线粗(pt)
        "lengthPercent": 30,       //     线长(占栏宽%)
        "spaceTwips": 20           //     线与正文间距(twips)
      },
      "gaijiFonts": {              //   缺字（>0xFFFF，如 Ext G/H）字体链：按序取本机已装首个写入 w:rFonts；
                                   //   繁体用补充字形，简体优先 SimSunExtB、缺失再补补充字形；全缺则写首项（Word 再回退）
        "zh-Hant": ["CBETA Supplement"],
        "zh-Hans": ["SimSun-ExtB", "SimSun-ExtG", "CBETA Supplement"]
      },
      "fallbackFonts": {           //   按字回退链（render-time 缺字拆 run，缺字不出 tofu）：按序取首个覆盖该字者；
                                   //   繁优先明体、简优先宋体；SimSunExtB 管 Ext-B 及以后；补充字形管 Ext C-G 与私用区；
                                   //   微软雅黑垫底（系统必带最后兜底）；空/缺省走内置默认
        "zh-Hant": ["PMingLiU", "SimSun", "SimSun-ExtB", "SimSun-ExtG", "CBETA Supplement",
                    "Microsoft YaHei"],
        "zh-Hans": ["SimSun", "SimSun-ExtB", "SimSun-ExtG", "CBETA Supplement",
                    "Microsoft YaHei"]
      },
      "siddhamFonts": ["Ranjana", "Siddam"]  //   悉昙字体（RJ 码按覆盖选用，官方同款 eastAsia="Ranjana"）：
                                             //   字体文件放 cbeta/fonts/；未装则主题字体直显 rjchar（可读非悉昙体）
    },
    "pagination": {                // [docx] 智能分页（总闸 enabled + 6 项子规则全可配置）
      "enabled": true,            //   总闸：true=启用智能分页（出厂默认开）；false=以下 6 项全部失活，保持自然排版
      "duplex": false,             //   true=双面打印：每个分页单元置于单数页（oddPage 分节，Word 自动补空白偶页）
      "juan": true,                //   true=卷首分页：第 2 卷起每卷换页（由 <cb:jhead> 触发）
      "juan_first": false,         //   true=第 1 卷也换页（书名独占一页）；false=第 1 卷紧跟书名不分页（默认）
      "mulu_levels": [1],          //   目录分页 level（显式优先）：[1]=仅 level-1（序/品/其他，默认）；[1,2]/[1,2,3]/[1,2,3,4]=更深；[]=关；epub 同步按此拆章节
      "mulu_level1": true,         //   （旧键，兼容）未写 mulu_levels 时：true≡[1]、false≡[]
      "mulu_zhang_break": true,    //   章独立成页：mulu 形如「第X章」时无视 level 独立成页（默认开；需 mulu_levels 非空）；章恒不参与合页；epub 同步拆章
      "mulu_heading_merge": false, //   空标题并入下节：本节只有标题（mulu/head）、没有正文时与下一节同页（同卷内；默认关）
      "mulu_smart_merge": true,    //   智能合页：level≥2 的短节与下一节同页（前一节估高 < 页高×mulu_smart_max_frac）
      "mulu_smart_max_frac": 0.3333, //  智能合页阈值（占页比例，估算：按当前纸张/边距/字号/行距估段高；默认 1/3=0.3333；仅下拉含 level≥2 时生效）
      "pb": false,                 //   true=按 <cb:pb> 官方刻本页边界分页（默认 false）
      "tei": true                  //   true=尾页【經文資訊】换页
    },
    "series_title": {              // [docx] 经藏名（<title level="s">）仅首页左上角打印
      "enabled": true              //   true=打印（默认）；false=不打印；字体/字号走 CSS p.series-title，
                                   //   旧 font/size 键保留作回退（老用户槽不断行为），新配置勿加
    }
  },

  "source": {
    // 本机路径放 presets/config.user.json（不入库）；出厂留空，空即报错提示去配。
    // CLI --xml-dir/--cbeta-ebook 可覆盖；GUI 数据源窗口可视编辑后存当前选中预设
    "catalog": "cbeta/data/sutra_mapping.txt",  // 仓库相对路径，钉死内置（fetch.resolve_catalog 按仓库根解析；禁止自定义）
    "xml_dir": "",        // 本地 XML 候选源（只读，角色同远端 URL；不得与 cbeta_ebook 相同）
    "xml_dir": "",        // 本地 XML 候选源（只读，角色同远端 URL；不得与 cbeta_ebook 相同）
    "cbeta_ebook": "",    // 电子书输出目录（唯一可写）：平展一部一目录，XML+基线同目录
    "verify_root": "",    // 校验产物总目录（为空=跟随输出目录，即 {输出}/验证；CLI --verify-root 优先）
    "title_t2s": true     // 工作目录名 {id} {书名} 的书名转简体（t2s；目录名用）
  },

  "downloads": {
    // CBETA 官方下载 URL 模板（{} 为占位符，可按官方更新）
    "xml": "https://raw.githubusercontent.com/cbeta-org/xml-p5/master/{canon}/{canon}{vol}/{file}",
    "html": "https://cbdata.dila.edu.tw/stable/download/html/{id}.html.zip",
    "docx": "https://cbdata.dila.edu.tw/stable/download/docx/{canon}/{id}.zip",
    "epub": "https://cbdata.dila.edu.tw/stable/download/epub/{canon}/{id}.epub",
    "txt_notes": "https://cbdata.dila.edu.tw/stable/download/text-with-notes/{id}.txt.zip",
    "odt": "https://cbdata.dila.edu.tw/stable/download/odt/{canon}/{id}.zip",
    "figures": "https://raw.githubusercontent.com/cbeta-git/CBR2X-figures/master/{canon}/{file}"  // 插图（graphic url 去 ../figures/ 前缀即 {canon}/{file}）
  },

  "verify": {
    // 校验专用配置，覆盖 output 中同名选项（output 保持全角等默认，verify 用 halfwidth 等便于比对）
    "enabled": true,                    // 转换后校验开关（GUI 校验卡复选可改；默认打开）
    "inline_brackets": "halfwidth",      // 校验时 inline 括号 halfwidth="()"（覆盖 output 的 fullwidth）
    "suppress_jhead_dup": false,         // 校验时 jhead 不去重（覆盖 output）
    "show_close_juan": true,             // 校验时显示结束卷标题
    "compareInfos": false,               // 校验时是否比较【經文資訊】段落（默认全量不比）
    "maxDiff": 10,                       // 默认阈值
    "diffLines": 5,                      // 默认差异行数
    "auto_fetch": true,                  // 基线缺失默认自动从官方下载（缺键也下载；设 false 关闭；失败静默跳过）
    "scope_juan": true,                  // true=官方基线限定到 XML 实际卷数（milestone n 对应 _NNN 文件，如 TX07n0006→TX0006_001..006.html 而非整编 49 文件）
    "bases": {                           // 各格式基线链（首选→回退；官方有变改这里，不改代码；缺键/非法回退内置默认）
      "md": ["txt_notes", "html"],
      "docx": ["docx", "html"],
      "html": ["html"],
      "txt": ["txt_notes"],
      "epub": ["txt_notes", "epub", "html"]
    }
  },

  "annotations": {
    // 难字注音（P6）：默认关闭；开启后作用于正文 Text 节点与解析后缺字（<g> 解析出的 Unicode 字参与词表/自动注音；
    // 未解析的 PUA/图片字、校勘记/题署不注）。
    // 词形匹配发生在 t2s（简体）与 gaiji 解析之后，词表词形须与渲染文本逐字一致。
    // verify 校验默认忽略注音（html <rt>、docx w:rt 在提取时剥除，md 〔〕括注由 normalize 剥除），
    // 故开启注音不影响回归基线比对。
    "enabled": true,                    // true=开启注音（默认 false）
    "scheme": "pinyin",                  // "pinyin"（拼音）或 "zhuyin"（注音符号）
    "style": "field",                   // 注音位置："ruby"=汉字上方（html/epub <ruby>、docx w:ruby；仅浏览器/Word 可见，
                                         //   LibreOffice/WPS 整段丢弃注音含原文）；"inline"=汉字右侧行内括注（所有阅读器可见，默认 inline）；
                                         //   "field"=汉字上方 EQ 拼音指南域（docx 专用，WPS/Word 可见;html 回退 ruby，md 回退行内）
    "brackets": ["〔", "〕"],            // 右侧注音括号（一对单字）；默认〔〕；verify 透明，自定义符号仅读音内容被剥除；
                                         // 避免用 []（与校勘短标记剥除规则冲突），（）可用但会降低校勘括号差异敏感度
    "rt_size": "50%",                   // 注音字号（上方 ruby 生效；行内括注为纯文本无字号）："50%"=相对所在段落字号，
                                         // 亦可写绝对值如 "7pt"；html 写成 ruby rt CSS，docx 写 w:rt 字号 + w:hps
    "rt_font": "",                       // 注音字体：空=继承正文字体；如 "楷体"（html 写 font-family，docx 写 w:rFonts）
    "ruby_up": "100%",                   // EQ 域抬升量（field 模式）：默认 100% 正文字号（整字高，不与正文相交）；WPS 原生约 60%，字框高时不够可改大，如 "120%" 或 "14pt"
    "repeat": "page",                     // 注音频率：all=每次都注（默认）；first=全文只注首次；page=每页只注首次
                                         //   （docx=按原书页 <pb> 翻页重注；html/epub=按卷文件；md/txt=整篇，无分页）
                                         //   无 <pb> 的典籍 docx 回退到每个智能分页单元 / 按卷（split 时）
    "rare_zones": ["A","B","C","D","E","F","G","H","I"],                    // 生僻字自动注音分区：空=关闭；如 ["G","H"]（Ext G/H），全扩展 ["A","B","C","D","E","F","G","H","I"]；
                                         // 需 pypinyin，未收录字回退 gaiji 规范化字（norm_big5_char 等）取音；与词表同样受 repeat 去重；
                                         // 词表优先（full_text 除外），多音字取最常用读音（可能不准，需人工校对）
    "full_text": false,                   // 全文注音：true=词表优先整词注音、其余逐字注音（忽略 rare_zones/repeat；专音以词表为准）
    "rare_font": "",                     // 补充字形 cmap 注音：空=关闭；TTF/OTF 路径（如 "cbeta/fonts/CBETASupplement.ttf"，
                                         //   相对路径先相对本 config 所在目录），覆盖字形内全部汉字（13943 字）自动注音；与 rare_from 为"或"关系
    "file": ""                           // 外部词表 TSV 路径；空=内置 pycbeta/data/annotations.txt；相对路径先相对本 config 所在目录
  }
}
